# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Unit test / coverage reports
.pytest_cache/
.cache
.hypothesis/

# Virtual environments
.venv/
venv/
ENV/
env/

# VS Code and PyCharm settings
.vscode/
.idea/

# Large data and archive files (to prevent GitHub push failures)
*.zip
*.tar
*.gz
*.tar.gz
*.tgz
*.rar
*.7z

# Model weights and checkpoints
*.pt
*.pth
*.bin
*.ckpt
*.h5
*.onnx
